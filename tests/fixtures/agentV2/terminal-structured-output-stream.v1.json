        { "sequence": 1, "type": "run_start" },
        { "sequence": 2, "type": "message_start", "messageId": "message-1-semantic" },
        { "sequence": 3, "type": "text_delta", "messageId": "message-1-semantic", "delta": "Analysis is ready." },
        { "sequence": 4, "type": "semantic_content", "messageId": "message-1-semantic" },
        { "sequence": 5, "type": "thread" },
        { "sequence": 6, "type": "message_end", "messageId": "message-1-semantic", "finishReason": "complete" }
      ],
      "expectedHydration": {
        "status": "complete",
        "actionIds": [],
        "semanticContentCount": 1,
        "invalidEvent": false
      }
    },
    {
