{
  "schemaVersion": 1,
  "contractVersion": "structured-terminal-bundle-v1",
  "cases": [
    {
      "id": "complete.action-committed-terminal-bundle",
      "expectedValid": true,
      "terminalOutcome": "complete",
      "terminalBundleStartsAtSequence": 4,
      "deliveryCursors": [0, 3, 4, 5],
      "events": [
        { "sequence": 1, "type": "run_start" },
        { "sequence": 2, "type": "message_start", "messageId": "message-1" },
        { "sequence": 3, "type": "text_delta", "messageId": "message-1", "delta": "Ready for review." },
        { "sequence": 4, "type": "action", "messageId": "message-1", "structuredId": "action-send-1" },
        { "sequence": 5, "type": "thread" },
        { "sequence": 6, "type": "message_end", "messageId": "message-1", "finishReason": "complete" }
      ],
      "expectedHydration": {
        "status": "complete",
        "actionIds": ["action-send-1"],
        "semanticContentCount": 0,
        "invalidEvent": false
      }
    },
    {
      "id": "complete.semantic-content-committed-terminal-bundle",
      "expectedValid": true,
      "terminalOutcome": "complete",
      "terminalBundleStartsAtSequence": 4,
      "deliveryCursors": [0, 3, 4, 5],
